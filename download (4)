    let currentCard = 0;

    const card = document.getElementById("card");
    const question = document.getElementById("question");
    const answer = document.getElementById("answer");
    const progressText = document.getElementById("progressText");
    const cardSlider = document.getElementById("cardSlider");
    const previousButton = document.getElementById("previousButton");
    const nextButton = document.getElementById("nextButton");

    cardSlider.max = flashcards.length - 1;

    function updateCard(animationClass = "") {
      card.classList.remove("flipped");
      card.classList.remove("slide-from-left", "slide-from-right");

      void card.offsetWidth;

      if (animationClass) {
        card.classList.add(animationClass);
      }

      // Automatically add the question number
      question.textContent =
        `${currentCard + 1}. ${flashcards[currentCard].question}`;

      answer.textContent = flashcards[currentCard].answer;

      progressText.textContent =
        `Card ${currentCard + 1} of ${flashcards.length}`;

      cardSlider.value = currentCard;

      card.setAttribute(
        "aria-label",
        `Flashcard ${currentCard + 1} of ${flashcards.length}. ` +
        "Tap to flip, swipe left for next, or swipe right for previous."
      );
    }

    function flipCard() {
      card.classList.toggle("flipped");
    }

    function nextCard() {
      currentCard = (currentCard + 1) % flashcards.length;
      updateCard("slide-from-right");
    }

    function previousCard() {
      currentCard =
        (currentCard - 1 + flashcards.length) % flashcards.length;

      updateCard("slide-from-left");
    }

    previousButton.addEventListener("click", previousCard);
    nextButton.addEventListener("click", nextCard);

    cardSlider.addEventListener("input", () => {
      currentCard = Number(cardSlider.value);
      updateCard();
    });

    card.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        flipCard();
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        previousCard();
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        nextCard();
      }
    });

    let startX = 0;
    let startY = 0;
    let startTime = 0;
    let moved = false;

    card.addEventListener("pointerdown", (event) => {
      startX = event.clientX;
      startY = event.clientY;
      startTime = Date.now();
      moved = false;

      card.setPointerCapture(event.pointerId);
    });

    card.addEventListener("pointermove", (event) => {
      const distanceX = Math.abs(event.clientX - startX);
      const distanceY = Math.abs(event.clientY - startY);

      if (distanceX > 10 || distanceY > 10) {
        moved = true;
      }
    });

    card.addEventListener("pointerup", (event) => {
      const distanceX = event.clientX - startX;
      const distanceY = event.clientY - startY;
      const elapsedTime = Date.now() - startTime;

      const isQuickGesture = elapsedTime <= 800;

      const isHorizontalSwipe =
        Math.abs(distanceX) >= 50 &&
        Math.abs(distanceX) > Math.abs(distanceY);

      const isSwipeUp =
        distanceY <= -50 &&
        Math.abs(distanceY) > Math.abs(distanceX);

      if (isQuickGesture && isHorizontalSwipe) {
        if (distanceX < 0) {
          nextCard();
        } else {
          previousCard();
        }
      } else if (isQuickGesture && isSwipeUp) {
        flipCard();
      } else if (!moved) {
        flipCard();
      }
    });

    card.addEventListener("pointercancel", () => {
      moved = true;
    });

    updateCard();
  </script>
</body>
